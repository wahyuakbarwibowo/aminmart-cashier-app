# Salin file ini menjadi admin-web/.env.local (JANGAN di-commit)
# URL & anon key: Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# SERVICE ROLE: rahasia, hanya dipakai server (API route), tidak pernah sampai browser.
# Di Vercel masukkan sebagai Environment Variable terenkripsi.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-RAHASIA...
